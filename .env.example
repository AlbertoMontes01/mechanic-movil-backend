DATABASE_URL="postgresql://user:password@localhost:5432/mechanic_movil?schema=public"
JWT_SECRET="change-me"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_DAYS=30
PORT=3001
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"

LEMONSQUEEZY_API_KEY="changeme"
LEMONSQUEEZY_WEBHOOK_SECRET="changeme"
LEMONSQUEEZY_STORE_ID="changeme"
LEMONSQUEEZY_VARIANT_ID="changeme"
# Kill switch for the paywall -- keep "false" in production until you're
# ready to require payment from every account. Routes/webhook work either
# way; this only controls whether requireActiveSubscription actually blocks.
SUBSCRIPTION_ENFORCEMENT_ENABLED="false"
# Comma-separated allowlist: these accounts get the real paywall even while
# the switch above is "false" -- for testing the full flow against one real
# account without exposing it to everyone else yet.
SUBSCRIPTION_ENFORCEMENT_TEST_EMAILS=""
