generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenant owner. One User = one mechanic/shop account. Clients themselves never
// get an account — they only receive a shared link or PDF.
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Password reset: store only a hash of the token (never the plaintext),
  // plus an expiry. A matching, unexpired hash is what reset-password checks.
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  clients            Client[]
  inventoryItems     InventoryItem[]
  inventoryCategories InventoryCategory[]
  shopSettings       ShopSettings?
  refreshTokens      RefreshToken[]
  subscription       Subscription?
  webhookEvents      WebhookEvent[]
  testimonial        Testimonial?
  surveyResponse     SurveyResponse?

  @@map("users")
}

// Access tokens are short-lived (15m) and never stored server-side; a
// refresh token is what actually gets persisted (hashed, like the password
// reset token) so it can be looked up, rotated on each use, and revoked
// individually (e.g. on logout) without invalidating every other session.
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Client {
  id        String   @id @default(uuid())
  mechanicId String
  mechanic  User     @relation(fields: [mechanicId], references: [id], onDelete: Cascade)

  name    String
  address String?
  city    String?
  state   String?
  zip     String?
  phone   String
  email   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles   Vehicle[]
  workOrders WorkOrder[]
  invoices   Invoice[]

  @@index([mechanicId])
  @@map("clients")
}

enum VehicleType {
  Truck
  Car
  SUV
  Van
  Motorcycle
  Other
}

model Vehicle {
  id       String  @id @default(uuid())
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  vehicleType  VehicleType @default(Truck)
  vin          String?
  // vin_last8 is intentionally NOT stored — derive it from `vin` at read time.
  year         Int?
  make         String
  model        String
  unitNumber   String?
  plate        String?
  odometer     Int?
  engineHours  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commonParts VehicleCommonPart[]
  workOrders  WorkOrder[]
  invoices    Invoice[]

  @@index([clientId])
  @@map("vehicles")
}

// Per-vehicle "usual parts" preset list (oil filter, engine serial, etc.),
// optionally linked to a real inventory item.
model VehicleCommonPart {
  id      String  @id @default(uuid())
  vehicleId String
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  name  String
  value String?

  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  position Int @default(0)

  @@index([vehicleId])
  @@map("vehicle_common_parts")
}

model InventoryCategory {
  id         String @id @default(uuid())
  mechanicId String
  mechanic   User   @relation(fields: [mechanicId], references: [id], onDelete: Cascade)

  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items InventoryItem[]

  @@unique([mechanicId, name])
  @@map("inventory_categories")
}

model InventoryItem {
  id         String @id @default(uuid())
  mechanicId String
  mechanic   User   @relation(fields: [mechanicId], references: [id], onDelete: Cascade)

  partNumber String?
  name       String
  stock      Int     @default(0)
  // What the mechanic paid for the part.
  cost       Decimal @default(0) @db.Decimal(10, 2)
  // What the mechanic charges the customer for it -- this, not cost, is
  // what invoice lines are priced from.
  price      Decimal @default(0) @db.Decimal(10, 2)
  // Whether low-stock alerts (the Inventory list badge, the dashboard's
  // Low Inventory widget) apply to this part. Off for parts the mechanic
  // doesn't want to bother tracking exact counts of.
  trackStock Boolean @default(true)

  categoryId String?
  category   InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicleCommonParts VehicleCommonPart[]
  workOrderParts     WorkOrderPartUsed[]
  invoiceLines       InvoiceLine[]

  @@index([mechanicId])
  @@map("inventory_items")
}

enum WorkOrderStatus {
  Draft
  InProgress
  ReadyToInvoice
  Invoiced
}

model WorkOrder {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  technicianName String?
  status         WorkOrderStatus @default(Draft)
  date           DateTime?       @db.Date
  generalNotes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects WorkOrderSubject[]
  invoice  Invoice?

  @@index([clientId])
  @@index([vehicleId])
  @@map("work_orders")
}

model WorkOrderSubject {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  description String?
  note        String?
  position    Int       @default(0)

  partsUsed WorkOrderPartUsed[]

  @@index([workOrderId])
  @@map("work_order_subjects")
}

// Strict FK to InventoryItem (confirmed decision) — no free-text part_number/
// name fallback. WorkOrderForm.jsx needs a real inventory picker here, same
// pattern as VehicleCommonPart's selector, with:
//   - an explicit "not in your inventory — add it first" empty state, and
//   - inline "+ Add new part" that creates the InventoryItem and
//     auto-selects it without losing the rest of the in-progress work order.
// onDelete Restrict: an inventory item referenced by a work order can't be
// hard-deleted (surface an "in use" error instead of silently orphaning it).
model WorkOrderPartUsed {
  id        String @id @default(uuid())
  subjectId String
  subject   WorkOrderSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  quantity Int @default(1)

  @@index([subjectId])
  @@index([inventoryItemId])
  @@map("work_order_parts_used")
}

enum InvoiceStatus {
  pending
  paid
}

model Invoice {
  id String @id @default(uuid())

  workOrderId String?    @unique
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  // True iff this invoice's own product lines decremented stock at
  // creation (i.e. it had no work_order_id then) -- decided once, at
  // creation, and never re-derived from workOrderId afterwards. Needed
  // because workOrderId can later go back to null on its own (the work
  // order it pointed to gets deleted, onDelete: SetNull) without this
  // invoice's lines ever having touched stock themselves; without a
  // separate flag, editing/deleting it afterwards would wrongly "restore"
  // stock that this invoice never actually consumed.
  stockAdjustedHere Boolean @default(false)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  invoiceNumber String?
  date          DateTime?     @db.Date
  status        InvoiceStatus @default(pending)

  subtotal Decimal @default(0) @db.Decimal(10, 2)
  tax      Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @default(0) @db.Decimal(10, 2)

  // Specific to this invoice (e.g. what was diagnosed/found) -- printed
  // below ShopSettings.invoiceTerms, which is the same on every invoice.
  customerNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines InvoiceLine[]

  @@index([clientId])
  @@index([vehicleId])
  @@map("invoices")
}

model InvoiceLine {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String?
  quantity    Int     @default(1)
  unitPrice   Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @default(0) @db.Decimal(10, 2)
  position    Int     @default(0)

  // Which inventory item this line came from, if it was a Product line
  // (a Service line leaves this null). Used to decrement/restore stock
  // for invoices that stand on their own (no work_order_id) -- an
  // invoice generated FROM a work order doesn't touch stock again here,
  // since the work order's own parts_used already did. SetNull rather
  // than Restrict: unlike an in-progress work order, there's no reason a
  // historical invoice should block deleting a part it once referenced.
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_lines")
}

// One row per mechanic (1:1 with User) — not a global singleton.
// taxRate is a PERCENTAGE (e.g. 8.5), matching the existing frontend UI,
// not a fraction.
model ShopSettings {
  id         String @id @default(uuid())
  mechanicId String @unique
  mechanic   User   @relation(fields: [mechanicId], references: [id], onDelete: Cascade)

  shopName String
  logoUrl  String?
  phone    String?
  address  String?
  taxRate  Decimal @default(0) @db.Decimal(5, 2)
  // Shop-wide boilerplate (warranty terms, payment policy, etc.) printed on
  // every invoice, above the invoice-specific "note to customer" -- set
  // once here rather than retyped per invoice.
  invoiceTerms String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shop_settings")
}

// ---------------------------------------------------------------------------
// Billing status for the mechanic's account (Lemon Squeezy is the merchant
// of record). One row per User, created at registration with
// status "pending_checkout" before any Lemon Squeezy subscription exists.
//
// `status` deliberately stores Lemon Squeezy's own status string verbatim
// (on_trial, active, past_due, unpaid, cancelled, expired, paused) rather
// than a translated Prisma enum -- a webhook handler that has to map LS's
// wording to a different enum is exactly the kind of translation layer that
// silently drifts out of sync the day LS adds or renames a status.
// ---------------------------------------------------------------------------
model Subscription {
  id         String @id @default(uuid())
  mechanicId String @unique
  mechanic   User   @relation(fields: [mechanicId], references: [id], onDelete: Cascade)

  status String @default("pending_checkout")

  lemonsqueezyCustomerId     String?
  lemonsqueezySubscriptionId String? @unique

  trialEndsAt DateTime?
  // Next billing date while active (LS's `renews_at`); effective end date
  // once cancelled (LS's `ends_at`, still-active-until-then).
  renewsAt    DateTime?
  endsAt      DateTime?

  // Display-only, for a future "Visa •••• 4242" line in Settings -- never
  // enough to charge anything, LS holds the actual payment method.
  cardBrand    String?
  cardLastFour String?

  // Lets support grant access without a real Lemon Squeezy subscription
  // (comped accounts, local dev/testing). The route-protection middleware
  // checks this before falling back to `status`.
  manualOverride Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Raw audit log of every Lemon Squeezy webhook delivery, keyed for
// idempotency. Lemon Squeezy doesn't hand back a stable event id in the
// payload, so `eventId` is a sha256 hash of the exact raw request body --
// LS resends a byte-identical body on retry, so the hash naturally dedupes
// retries without depending on any particular field being present.
//
// Kept indefinitely, not purged once processed: the first time a mechanic
// disputes "I paid and don't have access," this is what you check.
// ---------------------------------------------------------------------------
model WebhookEvent {
  id        String @id @default(uuid())
  eventId   String @unique
  eventName String
  payload   Json

  // Resolved from the checkout's custom_data once the payload is parsed;
  // null if that lookup fails (bad/missing custom_data), so the raw event
  // is still captured instead of being dropped for lack of somewhere to file it.
  mechanicId String?
  mechanic   User?   @relation(fields: [mechanicId], references: [id], onDelete: SetNull)

  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  // Set when processing throws, so failed events can be found and retried
  // deliberately instead of only ever surfacing in a log line.
  processingError String?

  @@index([mechanicId])
  @@map("webhook_events")
}

// One per mechanic (like ShopSettings) -- submitted from Settings, shown on
// the public landing page carousel. `published` defaults true (no
// moderation queue yet, this is a pre-launch app with a handful of users);
// revisit before this scales to a public signup flow with strangers.
model Testimonial {
  id         String @id @default(uuid())
  mechanicId String @unique
  mechanic   User   @relation(fields: [mechanicId], references: [id], onDelete: Cascade)

  rating  Int     @default(5)
  comment String
  // Display name shown on the landing page -- deliberately separate from
  // the account's real name/email, which are never public.
  authorName String?
  published  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

// One per mechanic, filled out once as a mandatory onboarding step (shown
// on first dashboard visit after registration/checkout, and on every page
// after that until answered -- see Layout.jsx). The row's mere existence
// IS the "has this account answered yet" flag; no separate boolean needed.
// Checkbox-style questions are stored as String[] (Postgres native array),
// single-choice range questions (years/age/operation size) as a plain
// String.
model SurveyResponse {
  id         String @id @default(uuid())
  mechanicId String @unique
  mechanic   User   @relation(fields: [mechanicId], references: [id], onDelete: Cascade)

  location String

  roles     String[]
  roleOther String?

  worksOn      String[]
  worksOnOther String?

  howYouWork      String[]
  howYouWorkOther String?

  yearsExperience String
  ageRange        String
  operationSize   String

  whatKeepsRunning String[]

  trackingMethods      String[]
  trackingMethodsOther String?

  createdAt DateTime @default(now())

  @@map("survey_responses")
}
