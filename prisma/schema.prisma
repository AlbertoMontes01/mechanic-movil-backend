generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenant owner. One User = one mechanic/shop account. Clients themselves never
// get an account — they only receive a shared link or PDF.
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Password reset: store only a hash of the token (never the plaintext),
  // plus an expiry. A matching, unexpired hash is what reset-password checks.
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  clients            Client[]
  inventoryItems     InventoryItem[]
  inventoryCategories InventoryCategory[]
  shopSettings       ShopSettings?
  refreshTokens      RefreshToken[]

  @@map("users")
}

// Access tokens are short-lived (15m) and never stored server-side; a
// refresh token is what actually gets persisted (hashed, like the password
// reset token) so it can be looked up, rotated on each use, and revoked
// individually (e.g. on logout) without invalidating every other session.
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Client {
  id        String   @id @default(uuid())
  mechanicId String
  mechanic  User     @relation(fields: [mechanicId], references: [id], onDelete: Cascade)

  name    String
  address String?
  city    String?
  state   String?
  zip     String?
  phone   String
  email   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles   Vehicle[]
  workOrders WorkOrder[]
  invoices   Invoice[]

  @@index([mechanicId])
  @@map("clients")
}

enum VehicleType {
  Truck
  Car
  SUV
  Van
  Motorcycle
  Other
}

model Vehicle {
  id       String  @id @default(uuid())
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  vehicleType  VehicleType @default(Truck)
  vin          String?
  // vin_last8 is intentionally NOT stored — derive it from `vin` at read time.
  year         Int?
  make         String
  model        String
  unitNumber   String?
  plate        String?
  odometer     Int?
  engineHours  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commonParts VehicleCommonPart[]
  workOrders  WorkOrder[]
  invoices    Invoice[]

  @@index([clientId])
  @@map("vehicles")
}

// Per-vehicle "usual parts" preset list (oil filter, engine serial, etc.),
// optionally linked to a real inventory item.
model VehicleCommonPart {
  id      String  @id @default(uuid())
  vehicleId String
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  name  String
  value String?

  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  position Int @default(0)

  @@index([vehicleId])
  @@map("vehicle_common_parts")
}

model InventoryCategory {
  id         String @id @default(uuid())
  mechanicId String
  mechanic   User   @relation(fields: [mechanicId], references: [id], onDelete: Cascade)

  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items InventoryItem[]

  @@unique([mechanicId, name])
  @@map("inventory_categories")
}

model InventoryItem {
  id         String @id @default(uuid())
  mechanicId String
  mechanic   User   @relation(fields: [mechanicId], references: [id], onDelete: Cascade)

  partNumber String?
  name       String
  stock      Int     @default(0)
  // What the mechanic paid for the part.
  cost       Decimal @default(0) @db.Decimal(10, 2)
  // What the mechanic charges the customer for it -- this, not cost, is
  // what invoice lines are priced from.
  price      Decimal @default(0) @db.Decimal(10, 2)

  categoryId String?
  category   InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicleCommonParts VehicleCommonPart[]
  workOrderParts     WorkOrderPartUsed[]

  @@index([mechanicId])
  @@map("inventory_items")
}

enum WorkOrderStatus {
  Draft
  InProgress
  ReadyToInvoice
  Invoiced
}

model WorkOrder {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  technicianName String?
  status         WorkOrderStatus @default(Draft)
  date           DateTime?       @db.Date
  generalNotes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects WorkOrderSubject[]
  invoice  Invoice?

  @@index([clientId])
  @@index([vehicleId])
  @@map("work_orders")
}

model WorkOrderSubject {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  description String?
  note        String?
  position    Int       @default(0)

  partsUsed WorkOrderPartUsed[]

  @@index([workOrderId])
  @@map("work_order_subjects")
}

// Strict FK to InventoryItem (confirmed decision) — no free-text part_number/
// name fallback. WorkOrderForm.jsx needs a real inventory picker here, same
// pattern as VehicleCommonPart's selector, with:
//   - an explicit "not in your inventory — add it first" empty state, and
//   - inline "+ Add new part" that creates the InventoryItem and
//     auto-selects it without losing the rest of the in-progress work order.
// onDelete Restrict: an inventory item referenced by a work order can't be
// hard-deleted (surface an "in use" error instead of silently orphaning it).
model WorkOrderPartUsed {
  id        String @id @default(uuid())
  subjectId String
  subject   WorkOrderSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  quantity Int @default(1)

  @@index([subjectId])
  @@index([inventoryItemId])
  @@map("work_order_parts_used")
}

enum InvoiceStatus {
  pending
  paid
}

model Invoice {
  id String @id @default(uuid())

  workOrderId String?    @unique
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  invoiceNumber String?
  date          DateTime?     @db.Date
  status        InvoiceStatus @default(pending)

  subtotal Decimal @default(0) @db.Decimal(10, 2)
  tax      Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines InvoiceLine[]

  @@index([clientId])
  @@index([vehicleId])
  @@map("invoices")
}

model InvoiceLine {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String?
  quantity    Int     @default(1)
  unitPrice   Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @default(0) @db.Decimal(10, 2)
  position    Int     @default(0)

  @@index([invoiceId])
  @@map("invoice_lines")
}

// One row per mechanic (1:1 with User) — not a global singleton.
// taxRate is a PERCENTAGE (e.g. 8.5), matching the existing frontend UI,
// not a fraction.
model ShopSettings {
  id         String @id @default(uuid())
  mechanicId String @unique
  mechanic   User   @relation(fields: [mechanicId], references: [id], onDelete: Cascade)

  shopName String
  logoUrl  String?
  phone    String?
  address  String?
  taxRate  Decimal @default(0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shop_settings")
}
